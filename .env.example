# Copy this file to .env and fill in the workspace-specific values.
# Load it before starting local QA:
#   set -a; source .env; set +a; ./ops/local-qa.sh

# Kakao Developers > App > Platform key > REST API key
HSU_KAKAO_CLIENT_ID=
# Required only when Client Secret is enabled for the Kakao app.
HSU_KAKAO_CLIENT_SECRET=

# Optional local QA database settings
HSU_QA_MYSQL_CONTAINER=hsu-hub-local-qa-db-13306
HSU_QA_MYSQL_PORT=13306
HSU_QA_DB_NAME=hsu_hub
HSU_QA_DB_USER=hsu_hub
HSU_QA_DB_PASSWORD=hsu_hub_local
HSU_QA_MYSQL_IMAGE=mysql:8.4

# Seeded operator account/session used for browser QA
HSU_QA_KAKAO_USER_ID=9000000001
HSU_QA_EMAIL=operator@local.test
HSU_QA_SESSION=local-qa-session
# Leave empty to use the first seeded club.
HSU_QA_CLUB_ID=
